---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';

const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-slate-200 text-slate-600 relative overflow-hidden">
  
  <!-- Subtle top accent line using watercolor gradient -->
  <div class="h-1 w-full bg-gradient-to-r from-[#0d6573] via-[#d97706] to-[#9d174d] opacity-80"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12 pb-14 border-b border-slate-200">
      
      <!-- Brand & Mission (Spans 2 cols) -->
      <div class="lg:col-span-2">
        <a href="#" class="inline-block focus:outline-none focus:ring-2 focus:ring-[#0d6573] rounded-lg">
          <Image 
            src={logoImage} 
            alt="EOONG" 
            class="h-9 w-auto object-contain"
            width={120}
            height={65}
          />
        </a>

        <p class="mt-4 text-sm text-slate-600 leading-relaxed max-w-sm">
          High-performance IT consulting & engineering built specifically for African small businesses. 
          Affordable IT. No complexity. Just results.
        </p>

        <!-- African Presence Badges -->
        <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100">
            🇳🇬 Lagos
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100">
            🇰🇪 Nairobi
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100">
            🇬🇭 Accra
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100">
            🇷🇼 Kigali
          </span>
        </div>

        <!-- Status Indicator -->
        <div class="mt-6 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-xs font-semibold text-emerald-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>All Services Operational • SLA 99.9%</span>
        </div>
      </div>

      <!-- Column 1: Services -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Solutions
        </h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href="#services" class="hover:text-[#0d6573] transition-colors">Web Development & PWAs</a>
          </li>
          <li>
            <a href="#services" class="hover:text-[#0d6573] transition-colors">Automation & n8n Workflows</a>
          </li>
          <li>
            <a href="#services" class="hover:text-[#0d6573] transition-colors">Data & Executive Dashboards</a>
          </li>
          <li>
            <a href="#services" class="hover:text-[#0d6573] transition-colors">African Payment Rails</a>
          </li>
          <li>
            <a href="#services" class="hover:text-[#0d6573] transition-colors">E-commerce Stores</a>
          </li>
          <li>
            <a href="#services" class="hover:text-[#0d6573] transition-colors">Mobile Apps (iOS & Android)</a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Process & Company -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Company
        </h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href="#why-us" class="hover:text-[#0d6573] transition-colors">Why Choose EOONG</a>
          </li>
          <li>
            <a href="#how-it-works" class="hover:text-[#0d6573] transition-colors">How It Works</a>
          </li>
          <li>
            <a href="#pricing" class="hover:text-[#0d6573] transition-colors">Pricing & Retainers</a>
          </li>
          <li>
            <a href="#industries" class="hover:text-[#0d6573] transition-colors">Industries We Serve</a>
          </li>
          <li>
            <a href="#testimonials" class="hover:text-[#0d6573] transition-colors">Client Case Studies</a>
          </li>
          <li>
            <a href="#contact" class="hover:text-[#0d6573] transition-colors">Book Discovery Call</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact & Channels -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Direct Connect
        </h4>
        <div class="mt-4 space-y-3 text-sm">
          <p class="text-xs text-slate-500">
            Direct channel to senior engineering:
          </p>
          <a
            href="mailto:hello@eoong.tech"
            class="block font-mono text-slate-900 hover:text-[#0d6573] font-semibold text-xs sm:text-sm underline"
          >
            hello@eoong.tech
          </a>
          <a
            href="https://wa.me/2348000000000"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-800"
          >
            <svg class="w-4 h-4 fill-current text-emerald-600" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>WhatsApp Dispatch</span>
          </a>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-3">
          <!-- Twitter / X -->
          <a href="https://x.com" target="_blank" rel="noopener noreferrer" aria-label="EOONG on X / Twitter" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 hover:text-slate-900 hover:bg-slate-200 transition-colors">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <!-- LinkedIn -->
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="EOONG on LinkedIn" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 hover:text-slate-900 hover:bg-slate-200 transition-colors">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <!-- GitHub -->
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="EOONG on GitHub" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 hover:text-slate-900 hover:bg-slate-200 transition-colors">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} EOONG Technologies. All rights reserved. Registered across West & East Africa.</p>
      <div class="flex items-center gap-6">
        <span>WCAG AA Accessible</span>
        <span>•</span>
        <span>Offline-First Optimized</span>
        <span>•</span>
        <span>Made with Pride in Africa</span>
      </div>
    </div>

  </div>
</footer>
