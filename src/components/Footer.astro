---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#1c2521]/15 bg-[#fdfcf9]">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-10 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:px-10">
    <div>
      <a href="#" class="inline-block">
        <Image src={logoImage} alt="EOONG" class="h-8 w-auto object-contain" width={120} height={65} />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-[#58635d]">Digital products and systems for businesses building their next chapter.</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-7 gap-y-3 text-xs font-semibold uppercase tracking-[0.12em] text-[#58635d]">
      <a href="#services" class="hover:text-[#b45c3b]">Services</a>
      <a href="#how-it-works" class="hover:text-[#b45c3b]">Process</a>
      <a href="#contact" class="hover:text-[#b45c3b]">Contact</a>
      <span class="text-[#1c2521]/40">© {currentYear} EOONG</span>
    </div>
  </div>
</footer>
