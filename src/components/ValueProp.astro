---
// ValueProp.astro
const valueProps = [
  {
    icon: '💰',
    colorName: 'teal',
    title: 'Affordability',
    headline: 'Premium solutions, small business prices',
    description:
      'You do not need a multi-million budget or bloated Silicon Valley rates to get high-performance technology. We build lean, high-ROI systems tailored to African SME budgets.',
    metric: 'Up to 60% less expensive than legacy agencies',
    colorClasses: {
      border: 'border-[#0d6573]/20 hover:border-[#0d6573]/50',
      badgeBg: 'bg-[#e6f4f6]',
      badgeText: 'text-[#0d6573]',
      iconBg: 'bg-[#0d6573]/10',
      iconText: 'text-[#0d6573]',
      accentBar: 'bg-[#0d6573]',
    },
    svgIcon: `<svg class="w-6 h-6 text-[#0d6573]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    icon: '⚡',
    colorName: 'amber',
    title: 'Speed',
    headline: 'Problems solved in weeks, not months',
    description:
      'Business in Africa moves fast, and delays mean lost revenue. We sprint directly from requirements to launch in 2 to 4 weeks using battle-tested modern architectures.',
    metric: '2–4 week deployment velocity',
    colorClasses: {
      border: 'border-[#d97706]/20 hover:border-[#d97706]/50',
      badgeBg: 'bg-[#fffbeb]',
      badgeText: 'text-[#b45309]',
      iconBg: 'bg-[#d97706]/10',
      iconText: 'text-[#d97706]',
      accentBar: 'bg-[#d97706]',
    },
    svgIcon: `<svg class="w-6 h-6 text-[#d97706]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
  {
    icon: '✨',
    colorName: 'rust',
    title: 'Quality',
    headline: 'Professional code, not shortcuts',
    description:
      'We write clean, production-grade code designed to handle erratic connectivity, real-time webhooks, high traffic spikes, and scale cleanly as your business grows.',
    metric: 'Production-grade architecture & test coverage',
    colorClasses: {
      border: 'border-[#c2410c]/20 hover:border-[#c2410c]/50',
      badgeBg: 'bg-[#fff7ed]',
      badgeText: 'text-[#9a3412]',
      iconBg: 'bg-[#c2410c]/10',
      iconText: 'text-[#c2410c]',
      accentBar: 'bg-[#c2410c]',
    },
    svgIcon: `<svg class="w-6 h-6 text-[#c2410c]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
  },
  {
    icon: '🎯',
    colorName: 'berry',
    title: 'Simplicity',
    headline: 'Tech explained clearly, no jargon',
    description:
      'No convoluted technical buzzwords or hand-waving. You get direct access to our core builders, transparent milestone roadmaps, and intuitive software anyone on your team can operate.',
    metric: 'Direct Slack/WhatsApp engineer access',
    colorClasses: {
      border: 'border-[#9d174d]/20 hover:border-[#9d174d]/50',
      badgeBg: 'bg-[#fdf2f8]',
      badgeText: 'text-[#831843]',
      iconBg: 'bg-[#9d174d]/10',
      iconText: 'text-[#9d174d]',
      accentBar: 'bg-[#9d174d]',
    },
    svgIcon: `<svg class="w-6 h-6 text-[#9d174d]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
  },
];
---

<section id="value-prop" class="py-20 bg-slate-50/50 border-y border-slate-100 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-700 shadow-xs mb-4">
        <span>Why African Founders Partner With Us</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Built Around Your Reality, Not Agency Overhead
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Most agencies either charge exorbitant multinational retainers or leave you stranded with messy freelance code. We provide the sweet spot.
      </p>
    </div>

    <!-- 4 Benefits Grid -->
    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {valueProps.map((item) => (
        <div 
          class={`group relative rounded-2xl bg-white p-7 transition-all duration-300 border ${item.colorClasses.border} shadow-xs hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between overflow-hidden`}
        >
          <!-- Top subtle accent line -->
          <div class={`absolute top-0 left-0 right-0 h-1 ${item.colorClasses.accentBar} opacity-80 transition-all duration-300 group-hover:h-1.5`}></div>

          <div>
            <!-- Icon & Tag -->
            <div class="flex items-center justify-between">
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${item.colorClasses.iconBg} transition-transform duration-300 group-hover:scale-110`}>
                <Fragment set:html={item.svgIcon} />
              </div>
              <span class={`text-xs font-bold tracking-wide uppercase px-2.5 py-1 rounded-md ${item.colorClasses.badgeBg} ${item.colorClasses.badgeText}`}>
                {item.title}
              </span>
            </div>

            <!-- Headline -->
            <h3 class="mt-5 text-lg font-bold text-slate-900 leading-snug">
              {item.headline}
            </h3>

            <!-- Description -->
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {item.description}
            </p>
          </div>

          <!-- Bottom Metric Chip -->
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-semibold text-slate-500">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item.metric}</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
