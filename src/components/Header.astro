---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';

const navLinks = [
  { name: 'Services', href: '#services' },
  { name: 'Why Us', href: '#why-us' },
  { name: 'How It Works', href: '#how-it-works' },
  { name: 'Pricing', href: '#pricing' },
  { name: 'Industries', href: '#industries' },
  { name: 'Testimonials', href: '#testimonials' },
];
---

<header class="sticky top-0 z-50 w-full transition-all duration-300 bg-white/85 backdrop-blur-md border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo -->
      <a href="#" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0d6573] rounded-lg p-1">
        <div class="relative flex items-center justify-center">
          <Image 
            src={logoImage} 
            alt="EOONG — Technology Solutions" 
            class="h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
            width={120}
            height={65}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 rounded-full hover:bg-slate-100/70 transition-all duration-200"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop CTAs -->
      <div class="hidden md:flex items-center gap-4">
        <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/60 text-xs font-semibold text-emerald-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Open for New Projects</span>
        </div>

        <a
          href="#contact"
          class="relative inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white rounded-full bg-[#0d6573] hover:bg-[#094752] transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-[#0d6573]/20 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#0d6573]"
        >
          <span>Get Started</span>
          <svg class="ml-1.5 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden items-center gap-2">
        <a
          href="#contact"
          class="px-3 py-1.5 text-xs font-semibold text-white rounded-full bg-[#0d6573]"
        >
          Get Started
        </a>
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 rounded-lg text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-[#0d6573]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 shadow-xl">
    <div class="flex flex-col space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link px-4 py-2.5 rounded-lg text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-colors"
        >
          {link.name}
        </a>
      ))}
      <div class="pt-4 border-t border-slate-100 flex flex-col gap-3">
        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-50 text-xs font-semibold text-emerald-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Currently accepting Q2/Q3 African business projects</span>
        </div>
        <a
          href="#contact"
          class="w-full text-center px-5 py-3 text-sm font-semibold text-white rounded-xl bg-[#0d6573] hover:bg-[#094752] transition-colors"
        >
          Start Your Project
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
