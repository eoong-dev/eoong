---
const steps = [
  ['01', 'Listen', 'We start with the problem, not a pre-packaged solution.'],
  ['02', 'Shape', 'We turn the right idea into a clear scope and plan.'],
  ['03', 'Make', 'We build, test and share progress in short, useful loops.'],
  ['04', 'Hand over', 'You get a finished system, the keys and the confidence to run it.'],
];
---

<section id="how-it-works" class="bg-[#1c2521] py-24 text-[#f4f1eb] sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="eyebrow text-[#d5a18b]">A considered process</p>
        <h2 class="mt-5 max-w-sm text-4xl leading-[0.95] sm:text-5xl">Good work takes a clear path.</h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <div class="border-t border-white/20">
          {steps.map(([number, title, description]) => (
            <div class="grid gap-4 border-b border-white/20 py-7 sm:grid-cols-[4rem_10rem_1fr] sm:gap-8">
              <span class="text-xs font-semibold tracking-[0.18em] text-[#d5a18b]">{number}</span>
              <h3 class="font-display text-3xl">{title}</h3>
              <p class="max-w-sm text-sm leading-relaxed text-[#bfc8c1]">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
