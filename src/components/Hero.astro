---
---

<section class="hero-editorial relative overflow-hidden bg-[#f4f1eb]">
  <div class="mx-auto max-w-7xl px-5 pb-20 pt-10 sm:px-8 lg:px-10 lg:pb-28 lg:pt-16">
    <div class="flex items-center justify-between border-b border-[#1c2521]/20 pb-4 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#58635d]">
      <span>Independent digital studio</span>
      <span class="hidden sm:inline">Lagos · Nairobi · Accra</span>
      <span>Est. 2024</span>
    </div>

    <div class="grid items-end gap-12 pt-16 lg:grid-cols-12 lg:gap-8 lg:pt-24">
      <div class="lg:col-span-8">
        <p class="mb-7 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#b45c3b]">
          <span class="h-px w-10 bg-[#b45c3b]"></span>
          Technology with intent
        </p>
        <h1 class="max-w-5xl font-display text-[clamp(3.5rem,8vw,8.5rem)] leading-[0.88] tracking-[-0.06em] text-[#1c2521]">
          Good tech should feel <em class="text-[#b45c3b]">simple.</em>
        </h1>
        <div class="mt-10 flex flex-col gap-8 sm:flex-row sm:items-end">
          <p class="max-w-md text-base leading-relaxed text-[#58635d] sm:text-lg">
            EOONG is a small, senior-led studio building useful digital products for ambitious businesses across Africa.
          </p>
          <a href="#contact" class="group inline-flex shrink-0 items-center gap-4 text-sm font-semibold text-[#1c2521]">
            Start a conversation
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#1c2521] text-white transition-transform duration-300 group-hover:translate-x-1">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-5-5 5 5-5 5" />
              </svg>
            </span>
          </a>
        </div>
      </div>

      <div class="relative lg:col-span-4 lg:pb-2">
        <div class="relative aspect-[4/5] overflow-hidden bg-[#d5dfd5]">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_25%,#f2c2a4_0,transparent_30%),linear-gradient(145deg,#244c49,#8ba69b_52%,#d8a46c)]"></div>
          <div class="absolute -right-10 top-12 h-56 w-56 rounded-full border-[26px] border-[#f4f1eb]/70"></div>
          <div class="absolute -bottom-20 -left-16 h-72 w-72 rounded-full border-[34px] border-[#b45c3b]/70"></div>
          <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between border-t border-white/50 pt-4 text-[10px] font-semibold uppercase tracking-[0.18em] text-white">
            <span>Build less<br />build better</span>
            <span>01 / 04</span>
          </div>
        </div>
        <p class="mt-4 max-w-xs text-xs leading-relaxed text-[#58635d]">
          From the first sketch to the last detail, we make technology feel considered, clear and distinctly yours.
        </p>
      </div>
    </div>

    <div class="mt-20 flex flex-wrap items-center gap-x-10 gap-y-3 border-t border-[#1c2521]/20 pt-5 text-xs text-[#58635d]">
      <span class="font-semibold uppercase tracking-[0.18em] text-[#1c2521]">What we do</span>
      <span>Websites & digital products</span>
      <span>Automation & systems</span>
      <span>Mobile experiences</span>
    </div>
  </div>
</section>
