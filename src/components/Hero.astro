---
// Hero.astro
---

<section class="relative overflow-hidden pt-8 pb-16 lg:pt-16 lg:pb-24 bg-white">
  <!-- Subtle Ambient Watercolor Mesh (extracted from logo colors) -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-[20%] left-[10%] h-[480px] w-[480px] rounded-full bg-[#0d6573]/8 blur-[100px]"></div>
    <div class="absolute top-[10%] -right-[10%] h-[500px] w-[500px] rounded-full bg-[#d97706]/7 blur-[120px]"></div>
    <div class="absolute bottom-[0%] left-[30%] h-[420px] w-[420px] rounded-full bg-[#c2410c]/6 blur-[110px]"></div>
    <div class="absolute top-[40%] left-[5%] h-[380px] w-[380px] rounded-full bg-[#9d174d]/6 blur-[110px]"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Regional Context Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-50 border border-slate-200/90 shadow-xs mb-6">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0d6573] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#0d6573]"></span>
          </span>
          <span class="text-xs sm:text-sm font-medium text-slate-700">
            Dedicated IT Consulting & Engineering for African Scale
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.12]">
          Technology Solutions Built for <span class="relative inline-block">
            <span class="relative z-10 text-gradient-eoong">African Small Businesses</span>
            <span class="absolute bottom-1.5 left-0 w-full h-3 bg-[#e6f4f6] -z-10 rounded-sm transform -rotate-1"></span>
          </span>
        </h1>

        <!-- Subheading -->
        <p class="mt-6 text-xl sm:text-2xl font-medium text-slate-600 leading-relaxed">
          Affordable IT. <span class="text-slate-900 font-semibold">No Complexity.</span> Just Results.
        </p>

        <!-- Description Paragraph -->
        <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
          We eliminate the high costs, clunky software, and confusing tech jargon. 
          From custom web platforms and mobile apps to automated payment workflows, 
          we build high-performance tools engineered for real businesses across Africa.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a
            href="#contact"
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white rounded-full bg-[#0d6573] hover:bg-[#094752] transition-all duration-300 shadow-lg shadow-[#0d6573]/25 hover:shadow-xl hover:shadow-[#0d6573]/35 hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>Get Started</span>
            <svg class="ml-2.5 w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#services"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-full transition-all duration-200 hover:border-slate-300 hover:shadow-sm"
          >
            <span>Learn More</span>
            <svg class="ml-2 w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Trust Signals / Metric Badges -->
        <div class="mt-10 pt-8 border-t border-slate-200/80 grid grid-cols-3 gap-6 sm:gap-8 w-full max-w-xl">
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">2–4 <span class="text-base font-medium text-[#0d6573]">wks</span></div>
            <div class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">Average delivery speed</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">100%</div>
            <div class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">Code & IP ownership</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Zero</div>
            <div class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">Confusing tech jargon</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Tech Stack & System Preview -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Decorative Glow -->
          <div class="absolute -inset-1.5 rounded-3xl bg-gradient-to-r from-[#0d6573] via-[#d97706] to-[#9d174d] opacity-20 blur-xl"></div>

          <!-- Main Interactive System Card -->
          <div class="relative rounded-2xl bg-white border border-slate-200/90 shadow-2xl p-6 sm:p-7 overflow-hidden">
            
            <!-- Window Top Bar -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-400"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
              </div>
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 text-[11px] font-mono text-slate-600">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>eoong-engine // v3.4.0</span>
              </div>
            </div>

            <!-- Dashboard Mini Header -->
            <div class="mt-4 flex items-center justify-between">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Target Environment</span>
                <h3 class="text-lg font-bold text-slate-900">African SME Operations</h3>
              </div>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                100% Operational
              </span>
            </div>

            <!-- System Metrics Grid -->
            <div class="mt-5 grid grid-cols-2 gap-3">
              
              <!-- Metric 1: Payment Gateways -->
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 hover:border-[#0d6573]/30 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-slate-500 font-medium">Payment Rails</span>
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                </div>
                <div class="mt-1.5 font-bold text-sm text-slate-800 flex items-center gap-1.5">
                  <span>Paystack • M-Pesa</span>
                </div>
                <div class="mt-1 text-[11px] text-[#0d6573] font-medium">Auto-reconciliation active</div>
              </div>

              <!-- Metric 2: Speed / CWV -->
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 hover:border-[#d97706]/30 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-slate-500 font-medium">PageSpeed / UX</span>
                  <span class="text-xs font-bold text-emerald-600">99 / 100</span>
                </div>
                <div class="mt-1.5 font-bold text-sm text-slate-800">110ms LCP</div>
                <div class="mt-1 text-[11px] text-amber-700 font-medium">Optimized for 3G/4G</div>
              </div>

              <!-- Metric 3: Automated Sync -->
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 hover:border-[#c2410c]/30 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-slate-500 font-medium">Workflow Sync</span>
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                </div>
                <div class="mt-1.5 font-bold text-sm text-slate-800">WhatsApp ↔ CRM</div>
                <div class="mt-1 text-[11px] text-orange-700 font-medium">1,420 events today</div>
              </div>

              <!-- Metric 4: Offline PWA -->
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 hover:border-[#9d174d]/30 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-slate-500 font-medium">Architecture</span>
                  <span class="text-[10px] font-mono bg-pink-100 text-pink-800 px-1.5 py-0.5 rounded">PWA</span>
                </div>
                <div class="mt-1.5 font-bold text-sm text-slate-800">Offline-First</div>
                <div class="mt-1 text-[11px] text-pink-700 font-medium">Zero network data loss</div>
              </div>

            </div>

            <!-- Terminal / Code Snippet Preview -->
            <div class="mt-4 p-3 rounded-xl bg-slate-950 text-slate-200 font-mono text-xs overflow-x-auto shadow-inner">
              <div class="flex items-center justify-between text-slate-400 border-b border-slate-800 pb-1.5 mb-2 text-[10px]">
                <span>deploy.sh</span>
                <span class="text-emerald-400">● live sync</span>
              </div>
              <div class="space-y-1 text-[11px] leading-relaxed">
                <p><span class="text-emerald-400">$</span> eoong deploy --target=lagos-cluster</p>
                <p class="text-slate-400">✓ Compiling ultra-lean assets (38KB)</p>
                <p class="text-slate-400">✓ Verified Paystack webhook endpoints</p>
                <p class="text-cyan-300">✓ Production deployed: 0 downtime (2.1s)</p>
              </div>
            </div>

            <!-- Floating Micro-Badge -->
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span class="flex items-center gap-1.5 font-medium text-slate-700">
                <svg class="w-4 h-4 text-[#0d6573]" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Engineered for African business realities
              </span>
              <span class="text-slate-400 font-mono text-[11px]">SLA 99.9%</span>
            </div>

          </div>

          <!-- Decorative Floating Tag -->
          <div class="hidden sm:flex absolute -bottom-5 -left-6 items-center gap-2.5 bg-white py-2 px-4 rounded-xl border border-slate-200/90 shadow-lg text-xs font-semibold text-slate-800">
            <span class="flex h-2.5 w-2.5 rounded-full bg-[#d97706]"></span>
            <span>Zero Agency Overhead</span>
          </div>

          <!-- Decorative Floating Tag Right -->
          <div class="hidden sm:flex absolute -top-4 -right-4 items-center gap-2 bg-white py-1.5 px-3.5 rounded-xl border border-slate-200/90 shadow-lg text-xs font-semibold text-slate-800">
            <span class="text-emerald-500 font-bold">⚡</span>
            <span>Weeks, Not Months</span>
          </div>

        </div>
      </div>

    </div>

    <!-- Integrations Ecosystem Strip -->
    <div class="mt-16 pt-10 border-t border-slate-100">
      <p class="text-center text-xs font-semibold uppercase tracking-wider text-slate-400 mb-6">
        Seamlessly integrated with the tools African businesses rely on
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16 opacity-75 grayscale hover:grayscale-0 transition-all duration-300">
        
        <!-- Paystack -->
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm tracking-tight hover:text-[#0d6573] transition-colors">
          <svg class="w-5 h-5 text-[#00c3f7]" viewBox="0 0 24 24" fill="currentColor">
            <rect x="2" y="4" width="20" height="4" rx="1"/>
            <rect x="2" y="10" width="14" height="4" rx="1"/>
            <rect x="2" y="16" width="20" height="4" rx="1"/>
          </svg>
          <span>Paystack</span>
        </div>

        <!-- Flutterwave -->
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm tracking-tight hover:text-[#d97706] transition-colors">
          <svg class="w-5 h-5 text-[#fb9129]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L2 12l10 10 10-10L12 2z"/>
          </svg>
          <span>Flutterwave</span>
        </div>

        <!-- M-Pesa -->
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm tracking-tight hover:text-emerald-600 transition-colors">
          <span class="px-1.5 py-0.5 bg-emerald-600 text-white rounded text-[10px] font-black">M</span>
          <span>M-PESA</span>
        </div>

        <!-- WhatsApp Business -->
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm tracking-tight hover:text-emerald-500 transition-colors">
          <svg class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WhatsApp API</span>
        </div>

        <!-- n8n Automation -->
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm tracking-tight hover:text-rose-500 transition-colors">
          <span class="w-5 h-5 rounded bg-rose-500 text-white flex items-center justify-center text-[10px] font-black">n</span>
          <span>n8n / Workflows</span>
        </div>

        <!-- Stripe -->
        <div class="flex items-center gap-2 text-slate-700 font-bold text-sm tracking-tight hover:text-indigo-600 transition-colors">
          <svg class="w-5 h-5 text-indigo-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697.5 12.579.5 6.079.5 2.128 3.727 2.128 9.07c0 5.485 5.28 6.55 8.91 7.747 2.378.784 3.195 1.536 3.195 2.502 0 1.055-.956 1.63-2.585 1.63-2.316 0-5.344-1.077-7.234-2.174l-.94 5.568C5.556 25.474 8.793 26 11.954 26c6.88 0 10.976-3.23 10.976-8.736 0-5.328-4.78-6.906-8.954-8.114z"/>
          </svg>
          <span>Stripe Global</span>
        </div>

      </div>
    </div>

  </div>
</section>
