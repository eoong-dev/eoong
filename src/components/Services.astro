---

<section id="services" class="py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-12 border-b border-slate-200">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#e6f4f6] text-xs font-bold text-[#0d6573] uppercase tracking-wider mb-3">
          Our Full Capabilities
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          Services Designed to Solve Tangible Problems
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600">
          Everything your business needs to operate faster, automate tedious workflows, and scale profitably—without needing an expensive in-house tech department.
        </p>
      </div>

      <!-- Quick Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 self-start md:self-end">
        <button
          type="button"
          class="service-filter-btn active px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 bg-[#0d6573] text-white shadow-xs"
          data-filter="all"
        >
          All Services (6)
        </button>
        <button
          type="button"
          class="service-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 bg-slate-100 text-slate-600 hover:bg-slate-200"
          data-filter="web-mobile"
        >
          Web & Mobile
        </button>
        <button
          type="button"
          class="service-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 bg-slate-100 text-slate-600 hover:bg-slate-200"
          data-filter="automation-data"
        >
          Automation & APIs
        </button>
        <button
          type="button"
          class="service-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 bg-slate-100 text-slate-600 hover:bg-slate-200"
          data-filter="commerce-data"
        >
          Commerce & Data
        </button>
      </div>
    </div>

    <!-- 3-Column Services Grid -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="services-grid">
      {services.map((service) => (
        <article
          class={`service-card group relative rounded-2xl bg-white border border-slate-200/90 p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1.5 flex flex-col justify-between overflow-hidden ${service.hoverBorder}`}
          data-category={service.category}
        >
          <!-- Corner Glow -->
          <div 
            class="pointer-events-none absolute -top-12 -right-12 w-32 h-32 rounded-full opacity-0 group-hover:opacity-10 transition-opacity duration-300 blur-2xl"
            style={`background-color: ${service.accentColor};`}
          ></div>

          <div>
            <!-- Top Bar: Icon & Category Number -->
            <div class="flex items-center justify-between">
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${service.accentBg} transition-transform duration-300 group-hover:scale-110`}>
                <Fragment set:html={service.iconSvg} />
              </div>
              <span class="text-xs font-mono font-bold text-slate-400">
                {service.number}
              </span>
            </div>

            <!-- Service Name -->
            <h3 class="mt-6 text-xl font-bold text-slate-900 group-hover:text-slate-950 transition-colors">
              {service.name}
            </h3>

            <!-- Description -->
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {service.description}
            </p>

            <!-- Examples Bullet Points -->
            <div class="mt-6 pt-6 border-t border-slate-100">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
                Typical Deliverables:
              </span>
              <ul class="mt-3 space-y-2.5">
                {service.examples.map((ex) => (
                  <li class="flex items-start text-xs sm:text-sm text-slate-700">
                    <svg class="w-4 h-4 mr-2 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{ex}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom: Tech Stack Pills & CTA Anchor -->
          <div class="mt-8 pt-6 border-t border-slate-100">
            <div class="flex flex-wrap gap-1.5 mb-5">
              {service.techStack.map((tech) => (
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between pt-2">
              <span class="text-xs font-medium text-slate-500 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                {service.deliveryTime}
              </span>
              <a
                href="#contact"
                class="inline-flex items-center text-xs font-bold text-[#0d6573] hover:text-[#094752] group-hover:underline underline-offset-4"
              >
                <span>Request Scope</span>
                <svg class="ml-1 w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>

    <!-- Bottom Help Banner -->
    <div class="mt-16 rounded-2xl bg-slate-900 text-white p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-64 h-64 rounded-full bg-[#0d6573]/30 blur-3xl pointer-events-none"></div>
      <div>
        <span class="text-xs font-mono font-bold text-[#f59e0b] uppercase tracking-wider">Not sure where to begin?</span>
        <h4 class="text-xl sm:text-2xl font-bold mt-1 text-white">We assess your setup in a 20-minute discovery session</h4>
        <p class="text-slate-300 text-sm mt-1 max-w-xl">
          Tell us where your bottleneck is. We’ll outline exactly what tech you actually need (and what to skip).
        </p>
      </div>
      <a
        href="#contact"
        class="shrink-0 px-6 py-3.5 rounded-full bg-white text-slate-900 hover:bg-slate-100 font-bold text-sm transition-all duration-200 shadow-md"
      >
        Book Free Discovery Call
      </a>
    </div>

  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('.service-filter-btn');
  const serviceCards = document.querySelectorAll('.service-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('bg-[#0d6573]', 'text-white', 'shadow-xs');
        b.classList.add('bg-slate-100', 'text-slate-600');
      });
      btn.classList.remove('bg-slate-100', 'text-slate-600');
      btn.classList.add('bg-[#0d6573]', 'text-white', 'shadow-xs');

      const filter = btn.getAttribute('data-filter');

      serviceCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
