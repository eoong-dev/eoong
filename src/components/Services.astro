---
const services = [
  {
    number: '01',
    title: 'Digital products',
    description: 'Websites, portals and mobile experiences that are clear, fast and easy to use.',
    items: ['Websites & landing pages', 'Web apps & internal tools', 'Mobile-first experiences'],
  },
  {
    number: '02',
    title: 'Smarter operations',
    description: 'Quietly remove the repetitive work that slows your team down.',
    items: ['Workflow automation', 'Payments & API integrations', 'WhatsApp and CRM systems'],
  },
  {
    number: '03',
    title: 'Useful insight',
    description: 'Turn scattered business information into decisions you can act on.',
    items: ['Dashboards & reporting', 'Inventory and sales visibility', 'Data foundations for growth'],
  },
];
---

<section id="services" class="border-t border-[#1c2521]/15 bg-[#fdfcf9] py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="eyebrow">What we make</p>
        <h2 class="mt-5 max-w-sm text-4xl leading-[0.95] text-[#1c2521] sm:text-5xl">
          Less noise. More useful technology.
        </h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <p class="max-w-xl text-lg leading-relaxed text-[#58635d]">
          We help growing businesses move from messy processes to simple digital systems that work in the real world.
        </p>
        <div class="mt-14 border-t border-[#1c2521]/20">
          {services.map((service) => (
            <article class="grid gap-5 border-b border-[#1c2521]/20 py-8 sm:grid-cols-[4rem_1fr_auto] sm:gap-8">
              <span class="text-xs font-semibold tracking-[0.18em] text-[#b45c3b]">{service.number}</span>
              <div>
                <h3 class="font-display text-3xl text-[#1c2521]">{service.title}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-[#58635d]">{service.description}</p>
              </div>
              <ul class="space-y-2 text-xs text-[#58635d] sm:min-w-44">
                {service.items.map((item) => <li>— {item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
