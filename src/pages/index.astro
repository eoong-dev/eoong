---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="EOONG — Technology Solutions Built for African Small Businesses"
  description="Affordable IT. No Complexity. Just Results. Web development, automated workflows, data dashboards, and mobile solutions tailored for growing African businesses."
>
  <Header />
  <main id="main-content" class="flex-1">
    <!-- 1. Hero Section -->
    <div class="scroll-reveal">
      <Hero />
    </div>

    <!-- 2. Services Overview -->
    <div class="scroll-reveal">
      <Services />
    </div>

    <!-- 3. How It Works -->
    <div class="scroll-reveal">
      <HowItWorks />
    </div>

    <!-- 4. Call-to-Action Section -->
    <div class="scroll-reveal">
      <CTA />
    </div>
  </main>
  <!-- 5. Footer -->
  <Footer />
</Layout>
